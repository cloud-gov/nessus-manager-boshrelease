---
name: nessus-manager
packages:
- nessus-manager
properties:
  nessus-manager.license:
    description: "Nessus Manager license key"
  nessus-manager.groups:
    description: "Nessus Manager Group"
    default: internal
  nessus-manager.host:
    description: "Nessus Manager Host"
  nessus-manager.port:
    description: "Nessus Manager port"
    default: 443
  nessus-manager.expiration-days:
    description: Number of days to retain scans
    default: 90
templates:
  bin/ctl: bin/ctl
  bin/monit_debugger: bin/monit_debugger
  data/properties.sh.erb: data/properties.sh
  helpers/ctl_setup.sh.erb: helpers/ctl_setup.sh
  helpers/ctl_utils.sh: helpers/ctl_utils.sh
